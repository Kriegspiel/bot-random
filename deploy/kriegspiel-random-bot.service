[Unit]
Description=Kriegspiel Random Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fil
WorkingDirectory=/home/fil/dev/kriegspiel/bot-random
ExecStart=/home/fil/dev/kriegspiel/bot-random/.venv/bin/python /home/fil/dev/kriegspiel/bot-random/bot.py --poll-seconds 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
